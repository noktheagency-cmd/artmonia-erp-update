{
  "name": "artmonia-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "node scripts/cloudflare-build.mjs",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy --secrets-file tmp/cloudflare-preview/secrets.json",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:acceptance": "node scripts/run-t-matrix.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-course-sales": "node --import tsx scripts/backfill-course-sales.mjs",
    "db:backfill-course-sales:apply": "node --import tsx scripts/backfill-course-sales.mjs --apply",
    "env:prepare-staging": "node scripts/prepare-staging-env.mjs",
    "env:assert-staging": "node scripts/assert-staging-env.mjs",
    "deploy:staging:vercel": "npm run env:assert-staging && node scripts/deploy-vercel-hobby.mjs"
  },
