{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "deployOutputs": [],
      "commands": [
        { "path": "/app/node_modules/.bin" },
        { "src": "package-lock.json", "dest": "package-lock.json" },
        { "src": "package.json", "dest": "package.json" },
        { "src": "prisma.config.ts", "dest": "prisma.config.ts" },
        { "src": "prisma", "dest": "prisma" },
        "node -e \"console.log({cwd:process.cwd(),lockfile:require('./package-lock.json').lockfileVersion})\"",
        "npx --yes npm@10.9.4 ci"
      ]
    }
  }
}
