# =============================================================================
# Artmonia ERP — STAGING / Vercel Preview
# =============================================================================
# Copy to .env.staging (gitignored) or paste into Vercel → Project → Settings →
# Environment Variables with Environment = Preview (and optionally Development).
#
# NEVER put production Railway / erp.artmoniya.com / azhri… Supabase here.
# Staging DB = Academy (or a dedicated staging) Supabase project only.
# Railway auto-deploy should stay Disabled while you use this.
# =============================================================================

APP_ENV=staging
ALLOW_DEMO_SEED=true
# Do NOT set NODE_ENV on Vercel (platform sets it; setting production skips Tailwind/PostCSS install).
CLOUDFLARE_PREVIEW=false

# After first Vercel deploy, set this to the Preview URL (https://….vercel.app)
NEXT_PUBLIC_APP_URL=https://your-staging-app.vercel.app

# --- Academy / staging Supabase (NOT production) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pooler (6543) for serverless runtime on Vercel
DATABASE_URL=postgresql://postgres.YOUR_STAGING_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=erp&options=-c%20search_path%3Derp%2Cpublic%2Cextensions
# Session/direct for migrations (optional on Vercel; run migrate locally against staging)
DIRECT_URL=postgresql://postgres.YOUR_STAGING_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=erp&options=-c%20search_path%3Derp%2Cpublic%2Cextensions

# Optional on staging
CRON_SECRET=
EXPORT_SIGNING_SECRET=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_HR_BUCKET=

# Leave empty on staging unless you intentionally test these integrations
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCESS_TOKEN=
MCP_PUBLIC_URL=
BACKUP_DB_URL=
