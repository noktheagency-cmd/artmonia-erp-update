# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase client-side values
# Use the publishable key for browser-safe Supabase operations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-side values
# Never expose secret/service keys in NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database
# DATABASE_URL should use Supabase transaction pooler for serverless runtime.
# Example:
# Prisma adapter pool size is capped explicitly in src/server/db/prisma.ts.
# postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=erp&options=-c%20search_path%3Derp%2Cpublic%2Cextensions
DATABASE_URL=
# DIRECT_URL should use direct Postgres when IPv6 is available, or Supabase session pooler on IPv4-only networks.
# Example session pooler:
# postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?schema=erp&options=-c%20search_path%3Derp%2Cpublic%2Cextensions
DIRECT_URL=

# Cloudflare R2 — protected HR documents (server-only)
# Configure bucket CORS for PUT requests from NEXT_PUBLIC_APP_URL.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_HR_BUCKET=

# Nightly backup runner / GitHub Actions only; not required by the ERP runtime.
# Actual credentials belong in GitHub Actions Secrets, never in this file.
BACKUP_PROJECT_REF=azhriwieowdeuvbqjqvl
BACKUP_SUPABASE_URL=https://azhriwieowdeuvbqjqvl.supabase.co
BACKUP_DB_URL=
# PEM certificate downloaded from Supabase Database Settings > SSL Configuration.
BACKUP_DB_CA_CERT=
BACKUP_SUPABASE_SERVICE_KEY=
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=artmonia-backups
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Public age1... recipient only. Keep the private age identity outside GitHub/R2.
BACKUP_AGE_RECIPIENT=
# Configure all source R2 buckets here if HR/R2 file storage is enabled.
BACKUP_SOURCE_R2_BUCKETS=
BACKUP_SOURCE_R2_ACCOUNT_ID=
BACKUP_SOURCE_R2_ACCESS_KEY_ID=
BACKUP_SOURCE_R2_SECRET_ACCESS_KEY=

# Demo seed safety
# Required only if intentionally seeding demo data in production-like environments.
ALLOW_DEMO_SEED=false

# Local-only RBAC testing.
# In development, set this to a seeded ERP email such as sales@artmonia.local
# to preview scoped CRM access without signing in through Supabase Auth.
ERP_DEV_ACTOR_EMAIL=

# AI connectors / Model Context Protocol (Founder-only, read-only)
# Public Railway URL for this server. Keep the /mcp suffix.
MCP_PUBLIC_URL=https://your-railway-domain.up.railway.app/mcp
# Comma-separated Supabase OAuth client IDs approved for Claude and ChatGPT.
MCP_OAUTH_CLIENT_IDS=
# Backward-compatible single-client fallback. Prefer MCP_OAUTH_CLIENT_IDS.
MCP_OAUTH_CLIENT_ID=
# Optional extra JWT audience check. Leave empty until a Supabase custom access
# token hook is configured for this OAuth application.
MCP_EXPECTED_AUDIENCE=
# Optional comma-separated additions. The public app/MCP hosts are allowed automatically.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=https://claude.ai,https://claude.com,https://chatgpt.com,https://chat.openai.com

# Scheduled jobs
CRON_SECRET=

# Mobile attendance integration — server/Edge Function only
# Comma-separated values allow zero-downtime secret rotation. Each token must be 32+ characters.
MOBILE_ATTENDANCE_SERVER_TOKENS=
# Dedicated server-only community dispatcher credential; never place in the student gateway.
FIRCA_COMMUNITY_SERVER_TOKEN=
# Dedicated secret used only by the attendance finalizer scheduler.
ATTENDANCE_CRON_SECRET=
# Optional attendance policy overrides (defaults shown).
ATTENDANCE_QR_TTL_SECONDS=60
ATTENDANCE_QR_REFRESH_SECONDS=30
ATTENDANCE_CHECKIN_OPEN_MINUTES_BEFORE=15
ATTENDANCE_CHECKIN_CLOSE_MINUTES_AFTER=30

# Meta Marketing API (server-only)
META_BUSINESS_ID=
META_AD_ACCOUNT_ID=
META_APP_ID=
META_SYSTEM_USER_ID=
META_ACCESS_TOKEN=
# Optional. When set, server requests include appsecret_proof.
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
META_SYNC_MONTHS=8
META_SYNC_LOOKBACK_DAYS=14

# Instagram DM ingestion (server-only)
# META_APP_SECRET is also used to validate X-Hub-Signature-256.
# Conversations API account ID returned by the Instagram access token.
META_INSTAGRAM_ACCOUNT_ID=
# Account ID found in webhook entry.id. Set this when it differs from the token account ID.
META_INSTAGRAM_WEBHOOK_ACCOUNT_ID=
META_INSTAGRAM_ACCESS_TOKEN=
META_INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
META_INSTAGRAM_SYNC_CONVERSATION_LIMIT=100

# Optional observability
SENTRY_DSN=
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=false

# Optional storage/export controls
EXPORT_SIGNING_SECRET=
MAX_EXPORT_ROWS=50000

# AI-powered workshop offer generator
GOOGLE_GENERATIVE_AI_API_KEY=

# DM Intelligence through OpenRouter (server-only)
OPENROUTER_API_KEY=
