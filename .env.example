# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase client-side values
# Use the publishable key for browser-safe Supabase operations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-side values
# Never expose secret/service keys in NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database
# DATABASE_URL should use Supabase transaction pooler for serverless runtime.
# Example:
# postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=erp&options=-c%20search_path%3Derp%2Cpublic%2Cextensions
DATABASE_URL=
# DIRECT_URL should use direct Postgres when IPv6 is available, or Supabase session pooler on IPv4-only networks.
# Example session pooler:
# postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?schema=erp&options=-c%20search_path%3Derp%2Cpublic%2Cextensions
DIRECT_URL=

# Demo seed safety
# Required only if intentionally seeding demo data in production-like environments.
ALLOW_DEMO_SEED=false

# Local-only RBAC testing.
# In development, set this to a seeded ERP email such as sales@artmonia.local
# to preview scoped CRM access without signing in through Supabase Auth.
ERP_DEV_ACTOR_EMAIL=

# Scheduled jobs
CRON_SECRET=

# Optional observability
SENTRY_DSN=
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=false

# Optional storage/export controls
EXPORT_SIGNING_SECRET=
MAX_EXPORT_ROWS=50000
