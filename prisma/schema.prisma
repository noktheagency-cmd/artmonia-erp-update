}

enum HrNotificationStatus {
  SENT
  READ
  ACKNOWLEDGED
  RESOLVED

  @@schema("erp")
}

model User {
  mobilePushCampaigns MobilePushCampaign[]
  id              String   @id @default(uuid()) @db.Uuid
  authUserId      String?  @unique @map("auth_user_id") @db.Uuid
  fullName        String   @map("full_name")
  email           String   @unique
  phone           String?
  profilePhotoUrl String?  @map("profile_photo_url")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  roles                            UserRole[]
  managedLeads                     Lead[]                          @relation("LeadManager")
  managedStudents                  Student[]                       @relation("StudentManager")
  leadStageChanges                 LeadStageHistory[]              @relation("LeadStageChanger")
  statusChanges                    StudentStatusHistory[]          @relation("StatusChanger")
  billingMigrationReviews          StudentBillingMigrationReview[] @relation("BillingMigrationReviewer")
  createdPricingVersions           ProgramPricingVersion[]         @relation("PricingCreator")
  teacherAssignmentChanges         TeacherAssignmentHistory[]      @relation("TeacherAssignmentChanger")
  createdPayments                  Payment[]                       @relation("PaymentCreator")
  requestedRefundAdjustments       RefundAdjustment[]              @relation("RefundRequestedBy")
  financeApprovedAdjustments       RefundAdjustment[]              @relation("RefundFinanceApprovedBy")
  ownerApprovedAdjustments         RefundAdjustment[]              @relation("RefundOwnerApprovedBy")
  createdTeacherRules              TeacherContractRule[]           @relation("TeacherRuleCreator")
  generatedPayouts                 TeacherPayout[]                 @relation("PayoutGeneratedBy")
  approvedPayouts                  TeacherPayout[]                 @relation("PayoutApprovedBy")
  ownedTasks                       Task[]                          @relation("TaskOwner")
  createdTasks                     Task[]                          @relation("TaskCreator")
  personalNotifications            PersonalNotification[]          @relation("PersonalNotificationRecipient")
  ownedTargets                     Target[]                        @relation("TargetOwner")
  managedTargets                   Target[]                        @relation("TargetManager")
  createdCompanyMonthlyTargets     CompanyMonthlyTarget[]          @relation("CompanyMonthlyTargetCreator")
  updatedCompanyMonthlyTargets     CompanyMonthlyTarget[]          @relation("CompanyMonthlyTargetUpdater")
  createdCompanyKpiPlans           CompanyKpiPlan[]                 @relation("CompanyKpiPlanCreator")
  updatedCompanyKpiPlans           CompanyKpiPlan[]                 @relation("CompanyKpiPlanUpdater")
  auditLogs                        AuditLog[]                      @relation("AuditActor")
  authSessions                     AuthSessionRecord[]             @relation("AuthSessionUser")
  revokedAuthSessions              AuthSessionRecord[]             @relation("AuthSessionRevoker")
  createdStudentMobileAccounts     StudentMobileAccount[]          @relation("StudentMobileAccountCreator")
  createdEnrollmentBillingTerms    EnrollmentBillingTerm[]         @relation("EnrollmentBillingTermCreator")
  updatedStudentMobileAccounts     StudentMobileAccount[]          @relation("StudentMobileAccountUpdater")
  createdAttendanceSites           AttendanceSite[]                @relation("AttendanceSiteCreator")
  updatedAttendanceSites           AttendanceSite[]                @relation("AttendanceSiteUpdater")
  exports                          DataExport[]                    @relation("ExportRequestedBy")
  createdFinanceExpenses           FinanceExpense[]                @relation("FinanceExpenseCreator")
  employeeFinanceExpenses          FinanceExpense[]                @relation("FinanceExpenseEmployee")
  createdLessons                   Lesson[]                        @relation("LessonCreator")
  teacherProfile                   Teacher?                        @relation("TeacherUser")
  createdClassSlots                ClassSlot[]                     @relation("ClassSlotCreator")
  assignedStudentSchedules         StudentScheduleAssignment[]     @relation("StudentScheduleAssigner")
  createdSlotSessions              SlotSession[]                   @relation("SlotSessionCreator")
  createdAttendanceQrChallenges    AttendanceQrChallenge[]         @relation("AttendanceQrChallengeCreator")
  markedAttendanceRecords          AttendanceRecord[]              @relation("AttendanceMarker")
  createdLessonHomeworks           LessonHomework[]                @relation("LessonHomeworkCreator")
  updatedLessonHomeworks           LessonHomework[]                @relation("LessonHomeworkUpdater")
  createdAcademyAnnouncements      AcademyAnnouncement[]           @relation("AcademyAnnouncementCreator")
  updatedAcademyAnnouncements      AcademyAnnouncement[]           @relation("AcademyAnnouncementUpdater")
  createdWorkshopEvents            WorkshopEvent[]                 @relation("WorkshopEventCreator")
  assignedWorkshopParticipants     WorkshopParticipant[]           @relation("WorkshopParticipantAssigner")
  cancelledWorkshopParticipants    WorkshopParticipant[]           @relation("WorkshopParticipantCanceller")
  assignedWorkshopFollowUps        WorkshopParticipantFollowUp[]   @relation("WorkshopFollowUpAssignee")
  createdWorkshopFollowUps         WorkshopParticipantFollowUp[]   @relation("WorkshopFollowUpCreator")
  updatedWorkshopFollowUps         WorkshopParticipantFollowUp[]   @relation("WorkshopFollowUpUpdater")
  workshopFollowUpActivities       WorkshopFollowUpActivity[]      @relation("WorkshopFollowUpActivityActor")
  createdWorkshopPayments          WorkshopPayment[]               @relation("WorkshopPaymentCreator")
  voidedWorkshopPayments           WorkshopPayment[]               @relation("WorkshopPaymentVoider")
  voidedFinanceExpenses            FinanceExpense[]                @relation("FinanceExpenseVoider")
  createdMarketingCampaigns        MarketingCampaign[]             @relation("MarketingCampaignCreator")
  createdMarketingReports          MarketingCampaignReport[]
  responsibleMarketingContent      MarketingContentItem[]          @relation("MarketingContentResponsible")
  createdMarketingContent          MarketingContentItem[]          @relation("MarketingContentCreator")
  approvedMarketingContent         MarketingContentItem[]          @relation("MarketingContentApprover")
  marketingContentActivities       MarketingContentActivity[]      @relation("MarketingContentActivityActor")
  responsibleMarketingStrategies   MarketingStrategy[]             @relation("MarketingStrategyResponsible")
  createdMarketingStrategies       MarketingStrategy[]             @relation("MarketingStrategyCreator")
  createdMarketingStrategyExpenses MarketingStrategyExpense[]      @relation("MarketingStrategyExpenseCreator")
  hrEmployeeProfile                HrEmployee?
  corporateContactProfile          HrCorporateContact?
  createdBonusCampaigns            HrBonusCampaign[]               @relation("HrBonusCampaignCreator")
  bonusProgressAdjustments         HrBonusProgressAdjustment[]     @relation("HrBonusAdjustmentCreator")
  approvedBonusAwards              HrBonusAward[]                  @relation("HrBonusAwardApprover")
  createdHrNotifications           HrStaffNotification[]           @relation("HrNotificationCreator")
  createdHrEmployeeNotes           HrEmployeeNote[]                @relation("HrEmployeeNoteCreator")
  updatedHrEmployeeNotes           HrEmployeeNote[]                @relation("HrEmployeeNoteUpdater")
  uploadedHrEmployeeDocuments      HrEmployeeDocument[]            @relation("HrEmployeeDocumentUploader")
  createdCorporateCustomers        HrCorporateCustomer[]           @relation("HrCorporateCustomerCreator")
  archivedHrEmployees              HrEmployee[]                    @relation("HrEmployeeArchiver")
  createdDropdownCatalogOptions    DropdownCatalogOption[]         @relation("DropdownCatalogOptionCreator")
  updatedAboutProfiles             AboutProfile[]                  @relation("AboutProfileUpdater")
  createdKnowledgeCategories       KnowledgeCategory[]             @relation("KnowledgeCategoryCreator")
  updatedKnowledgeCategories       KnowledgeCategory[]             @relation("KnowledgeCategoryUpdater")
  createdKnowledgeArticles         KnowledgeArticle[]              @relation("KnowledgeArticleCreator")
  updatedKnowledgeArticles         KnowledgeArticle[]              @relation("KnowledgeArticleUpdater")

  @@map("users")
  @@schema("erp")
}

model AboutProfile {
  id           String   @id @default(uuid()) @db.Uuid
  singletonKey String   @unique @default("primary") @map("singleton_key") @db.VarChar(32)
  title        String   @db.VarChar(80)
  tagline      String   @db.VarChar(180)
  story        String   @db.Text
  mission      String   @db.Text
  vision       String   @db.Text
  values       String[] @default([])
  updatedById  String?  @map("updated_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("AboutProfileUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("about_profiles")
  @@schema("erp")
}

model KnowledgeSection {
  id        String                 @id @default(uuid()) @db.Uuid
  key       String                 @unique @db.VarChar(48)
  name      String                 @db.VarChar(80)
  type      KnowledgeSectionType
  position  Int                    @default(0)
  status    KnowledgeContentStatus @default(PUBLISHED)
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  categories KnowledgeCategory[]

  @@index([type, status, position])
  @@map("knowledge_sections")
  @@schema("erp")
}

model KnowledgeCategory {
  id          String                 @id @default(uuid()) @db.Uuid
  sectionId   String                 @map("section_id") @db.Uuid
  name        String                 @db.VarChar(120)
  position    Int                    @default(0)
  status      KnowledgeContentStatus @default(PUBLISHED)
  createdById String?                @map("created_by_id") @db.Uuid
  updatedById String?                @map("updated_by_id") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  section   KnowledgeSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdBy User?              @relation("KnowledgeCategoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?              @relation("KnowledgeCategoryUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  articles  KnowledgeArticle[]
  audiences KnowledgeCategoryAudience[]

  @@unique([sectionId, name])
  @@index([sectionId, status, position])
  @@index([createdById])
  @@index([updatedById])
  @@map("knowledge_categories")
  @@schema("erp")
}

model KnowledgeCategoryAudience {
  categoryId String   @map("category_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  category KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  employee HrEmployee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([categoryId, employeeId])
  @@index([employeeId, categoryId])
  @@map("knowledge_category_audiences")
  @@schema("erp")
}

model KnowledgeArticle {
  id          String                 @id @default(uuid()) @db.Uuid
  categoryId  String                 @map("category_id") @db.Uuid
  title       String                 @db.VarChar(180)
  content     Json                   @db.JsonB
  plainText   String                 @default("") @map("plain_text") @db.Text
  position    Int                    @default(0)
  status      KnowledgeContentStatus @default(DRAFT)
  createdById String?                @map("created_by_id") @db.Uuid
  updatedById String?                @map("updated_by_id") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  inheritAudience Boolean @default(true) @map("inherit_audience")
  audiences KnowledgeArticleAudience[]

  category  KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy User?             @relation("KnowledgeArticleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?             @relation("KnowledgeArticleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([categoryId, status, position])
  @@index([createdById])
  @@index([updatedById])
  @@map("knowledge_articles")
  @@schema("erp")
}

model KnowledgeArticleAudience {
  articleId String @map("article_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([articleId, employeeId])
  @@index([employeeId, articleId])
  @@map("knowledge_article_audiences")
  @@schema("erp")
}

model HrEmployee {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String?           @unique @map("user_id") @db.Uuid
  teacherId         String?           @unique @map("teacher_id") @db.Uuid
  staffType         HrStaffType       @default(EMPLOYEE) @map("staff_type")
  fullName          String            @map("full_name")
  email             String?
  phone             String?
  address           String?
  department        String
  position          String
  hireDate          DateTime          @map("hire_date") @db.Date
  status            HrEmployeeStatus  @default(ACTIVE)
  contractType      String            @default("FULL_TIME") @map("contract_type")
  salaryMode        FinanceSalaryMode @default(STATIC) @map("salary_mode")
  salaryAmount      Decimal           @default(0) @map("salary_amount") @db.Decimal(12, 2)
  salaryPercent     Decimal?          @map("salary_percent") @db.Decimal(5, 2)
  profilePhotoUrl   String?           @map("profile_photo_url")
  note              String?
  employmentEndedAt DateTime?         @map("employment_ended_at") @db.Date
  exitReason        String?           @map("exit_reason") @db.VarChar(500)
  archivedAt        DateTime?         @map("archived_at")
  archivedById      String?           @map("archived_by_id") @db.Uuid
  createdById       String?           @map("created_by_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  teacher              Teacher?              @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  bonusParticipants    HrBonusParticipant[]
  bonusFinanceExpenses FinanceExpense[]      @relation("FinanceExpenseHrEmployee")
  notifications        HrStaffNotification[]
  notes                HrEmployeeNote[]
  documents            HrEmployeeDocument[]
  knowledgeAudiences   KnowledgeCategoryAudience[]
  knowledgeArticleAudiences KnowledgeArticleAudience[]
  archivedBy           User?                 @relation("HrEmployeeArchiver", fields: [archivedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([archivedAt])
  @@index([employmentEndedAt])
  @@index([archivedById])
  @@index([department])
  @@map("hr_employees")
  @@schema("erp")
}

model HrEmployeeNote {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  title       String   @db.VarChar(160)
  content     Json
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee  HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy User?      @relation("HrEmployeeNoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?      @relation("HrEmployeeNoteUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([employeeId, updatedAt(sort: Desc)])
  @@index([createdById])
  @@index([updatedById])
  @@map("hr_employee_notes")
  @@schema("erp")
}

model HrEmployeeDocument {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  originalName String   @map("original_name") @db.VarChar(255)
  objectKey    String   @unique @map("object_key") @db.VarChar(500)
  mimeType     String   @map("mime_type") @db.VarChar(120)
  sizeBytes    Int      @map("size_bytes")
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  employee   HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy User?      @relation("HrEmployeeDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([employeeId, createdAt(sort: Desc)])
  @@index([uploadedById])
  @@map("hr_employee_documents")
  @@schema("erp")
}

model HrCorporateCustomer {
  id            String                    @id @default(uuid()) @db.Uuid
  name          String
  taxId         String?                   @unique @map("tax_id")
  status        HrCorporateCustomerStatus @default(ACTIVE)
  monthlyBudget Decimal                   @map("monthly_budget") @db.Decimal(14, 2)
  contractValue Decimal?                  @map("contract_value") @db.Decimal(14, 2)
  paymentDate   DateTime?                 @map("payment_date") @db.Date
  note          String?
  createdById   String?                   @map("created_by_id") @db.Uuid
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")

  createdBy       User?                @relation("HrCorporateCustomerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  contacts        HrCorporateContact[]
  financeExpenses FinanceExpense[]

  @@index([status, updatedAt])
  @@index([name])
  @@index([createdById])
  @@map("hr_corporate_customers")
  @@schema("erp")
}

model HrCorporateContact {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  userId     String?  @unique @map("user_id") @db.Uuid
  fullName   String   @map("full_name")
  position   String?
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer HrCorporateCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([customerId, isPrimary])
  @@index([email])
  @@map("hr_corporate_contacts")
  @@schema("erp")
}

model HrStaffNotification {
  id             String                 @id @default(uuid()) @db.Uuid
  employeeId     String                 @map("employee_id") @db.Uuid
  creatorUserId  String                 @map("creator_user_id") @db.Uuid
  category       HrNotificationCategory
