generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["erp"]
}

enum AppRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  SALES
  FINANCE
  TEACHER
  AUDITOR

  @@schema("erp")
}

enum PermissionScope {
  ASSIGNED
  ALL

  @@schema("erp")
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  TRIAL_CONSULTATION
  REGISTERED
  LOST
  NURTURE

  @@schema("erp")
}

enum LeadPriority {
  NORMAL
  MEDIUM
  CRITICAL

  @@schema("erp")
}

enum LeadNextActionType {
  CALL
  CONSULTATION_REMINDER
  PAYMENT_REMINDER
  FOLLOW_UP

  @@schema("erp")
}

enum StudentLifecycleStatus {
  GROUP_WAITING
  ACTIVE
  DEBT
  FROZEN
  STOPPED
  DECLINED
  COMPLETED

  @@schema("erp")
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED

  @@schema("erp")
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PARTIAL
  PAID
  OVERDUE
  VOID

  @@schema("erp")
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  OTHER

  @@schema("erp")
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED

  @@schema("erp")
}

enum ApprovalStatus {
  DRAFT
  REQUESTED
  FINANCE_APPROVED
  OWNER_APPROVED
  APPROVED
  REJECTED
  PAID

  @@schema("erp")
}

enum PaymentAllocationMode {
  OLDEST_FIRST
  SELECTED_INVOICE
  ADVANCE_TO_NEXT
  MANUAL

  @@schema("erp")
}

enum FinanceSalaryMode {
  NONE
  STATIC
  PERCENT

  @@schema("erp")
}

enum LessonStatus {
  RESERVED
  ATTENDED
  ABSENT
  CANCELLED

  @@schema("erp")
}

enum GroupWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@schema("erp")
}

enum AttendanceMark {
  PRESENT
  ABSENT

  @@schema("erp")
}

enum WorkshopEventType {
  WORKSHOP
  MASTERCLASS

  @@schema("erp")
}

enum WorkshopEventStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  CANCELLED

  @@schema("erp")
}

enum MarketingCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED

  @@schema("erp")
}

enum MarketingReportOutcome {
  SUCCESSFUL
  UNSUCCESSFUL

  @@schema("erp")
}

enum HrEmployeeStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  INACTIVE

  @@schema("erp")
}

enum HrStaffType {
  EMPLOYEE
  TEACHER

  @@schema("erp")
}

enum HrLookupKind {
  DEPARTMENT
  POSITION

  @@schema("erp")
}

enum HrBonusMetricKind {
  DEPARTMENT_COLLECTED_REVENUE
  DEPARTMENT_SALES_COUNT
  TEACHER_RETENTION_RATE
  MANUAL_KPI

  @@schema("erp")
}

enum HrBonusDistributionMode {
  EQUAL
  HR_APPROVAL

  @@schema("erp")
}

enum HrBonusCampaignStatus {
  SCHEDULED
  ACTIVE
  ACHIEVED
  EXPIRED
  CANCELLED

  @@schema("erp")
}

enum HrBonusAwardStatus {
  PENDING_HR
  APPROVED
  POSTED
  VOIDED

  @@schema("erp")
}

enum HrNotificationCategory {
  RULE_VIOLATION
  PERFORMANCE_WARNING
  INFORMATION
  APPRECIATION
  MANUAL

  @@schema("erp")
}

enum HrNotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@schema("erp")
}

enum HrNotificationStatus {
  SENT
  READ
  ACKNOWLEDGED
  RESOLVED

  @@schema("erp")
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  authUserId String?  @unique @map("auth_user_id") @db.Uuid
  fullName   String   @map("full_name")
  email      String   @unique
  phone      String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  roles                         UserRole[]
  managedLeads                  Lead[]                      @relation("LeadManager")
  managedStudents               Student[]                   @relation("StudentManager")
  leadStageChanges              LeadStageHistory[]          @relation("LeadStageChanger")
  statusChanges                 StudentStatusHistory[]      @relation("StatusChanger")
  createdPricingVersions        ProgramPricingVersion[]     @relation("PricingCreator")
  teacherAssignmentChanges      TeacherAssignmentHistory[]  @relation("TeacherAssignmentChanger")
  createdPayments               Payment[]                   @relation("PaymentCreator")
  requestedRefundAdjustments    RefundAdjustment[]          @relation("RefundRequestedBy")
  financeApprovedAdjustments    RefundAdjustment[]          @relation("RefundFinanceApprovedBy")
  ownerApprovedAdjustments      RefundAdjustment[]          @relation("RefundOwnerApprovedBy")
  createdTeacherRules           TeacherContractRule[]       @relation("TeacherRuleCreator")
  generatedPayouts              TeacherPayout[]             @relation("PayoutGeneratedBy")
  approvedPayouts               TeacherPayout[]             @relation("PayoutApprovedBy")
  ownedTasks                    Task[]                      @relation("TaskOwner")
  createdTasks                  Task[]                      @relation("TaskCreator")
  ownedTargets                  Target[]                    @relation("TargetOwner")
  managedTargets                Target[]                    @relation("TargetManager")
  auditLogs                     AuditLog[]                  @relation("AuditActor")
  exports                       DataExport[]                @relation("ExportRequestedBy")
  createdFinanceExpenses        FinanceExpense[]            @relation("FinanceExpenseCreator")
  employeeFinanceExpenses       FinanceExpense[]            @relation("FinanceExpenseEmployee")
  createdLessons                Lesson[]                    @relation("LessonCreator")
  teacherProfile                Teacher?                    @relation("TeacherUser")
  createdGroups                 StudentGroup[]              @relation("GroupCreator")
  assignedGroupMemberships      GroupMembership[]           @relation("GroupMembershipAssigner")
  createdGroupSessions          GroupSession[]              @relation("GroupSessionCreator")
  markedAttendanceRecords       AttendanceRecord[]          @relation("AttendanceMarker")
  createdWorkshopEvents         WorkshopEvent[]             @relation("WorkshopEventCreator")
  assignedWorkshopParticipants  WorkshopParticipant[]       @relation("WorkshopParticipantAssigner")
  cancelledWorkshopParticipants WorkshopParticipant[]       @relation("WorkshopParticipantCanceller")
  createdWorkshopPayments       WorkshopPayment[]           @relation("WorkshopPaymentCreator")
  voidedWorkshopPayments        WorkshopPayment[]           @relation("WorkshopPaymentVoider")
  voidedFinanceExpenses         FinanceExpense[]            @relation("FinanceExpenseVoider")
  createdMarketingCampaigns     MarketingCampaign[]         @relation("MarketingCampaignCreator")
  createdMarketingReports       MarketingCampaignReport[]
  hrEmployeeProfile             HrEmployee?
  createdBonusCampaigns         HrBonusCampaign[]           @relation("HrBonusCampaignCreator")
  bonusProgressAdjustments      HrBonusProgressAdjustment[] @relation("HrBonusAdjustmentCreator")
  approvedBonusAwards           HrBonusAward[]              @relation("HrBonusAwardApprover")
  createdHrNotifications        HrStaffNotification[]       @relation("HrNotificationCreator")

  @@map("users")
  @@schema("erp")
}

model HrEmployee {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String?           @unique @map("user_id") @db.Uuid
  teacherId       String?           @unique @map("teacher_id") @db.Uuid
  staffType       HrStaffType       @default(EMPLOYEE) @map("staff_type")
  fullName        String            @map("full_name")
  email           String?
  phone           String?
  department      String
  position        String
  hireDate        DateTime          @map("hire_date") @db.Date
  status          HrEmployeeStatus  @default(ACTIVE)
  contractType    String            @default("FULL_TIME") @map("contract_type")
  salaryMode      FinanceSalaryMode @default(STATIC) @map("salary_mode")
  salaryAmount    Decimal           @default(0) @map("salary_amount") @db.Decimal(12, 2)
  salaryPercent   Decimal?          @map("salary_percent") @db.Decimal(5, 2)
  profilePhotoUrl String?           @map("profile_photo_url")
  note            String?
  createdById     String?           @map("created_by_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  teacher              Teacher?              @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  bonusParticipants    HrBonusParticipant[]
  bonusFinanceExpenses FinanceExpense[]      @relation("FinanceExpenseHrEmployee")
  notifications        HrStaffNotification[]

  @@index([status])
  @@index([department])
  @@map("hr_employees")
  @@schema("erp")
}

model HrStaffNotification {
  id             String                 @id @default(uuid()) @db.Uuid
  employeeId     String                 @map("employee_id") @db.Uuid
  creatorUserId  String                 @map("creator_user_id") @db.Uuid
  category       HrNotificationCategory
  priority       HrNotificationPriority @default(NORMAL)
  title          String
  message        String
  status         HrNotificationStatus   @default(SENT)
  sentAt         DateTime               @default(now()) @map("sent_at")
  readAt         DateTime?              @map("read_at")
  acknowledgedAt DateTime?              @map("acknowledged_at")
  resolvedAt     DateTime?              @map("resolved_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  creator  User       @relation("HrNotificationCreator", fields: [creatorUserId], references: [id], onDelete: Restrict)

  @@index([employeeId, createdAt])
  @@index([employeeId, status])
  @@index([creatorUserId, createdAt])
  @@map("hr_staff_notifications")
  @@schema("erp")
}

model HrLookupOption {
  id        String       @id @default(uuid()) @db.Uuid
  kind      HrLookupKind
  name      String
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([kind, name])
  @@index([kind, isActive])
  @@map("hr_lookup_options")
  @@schema("erp")
}

model HrBonusCampaign {
  id                           String                  @id @default(uuid()) @db.Uuid
  name                         String
  department                   String
  startsAt                     DateTime                @map("starts_at") @db.Date
  endsAt                       DateTime                @map("ends_at") @db.Date
  metricKind                   HrBonusMetricKind       @map("metric_kind")
  distributionMode             HrBonusDistributionMode @default(EQUAL) @map("distribution_mode")
  status                       HrBonusCampaignStatus   @default(ACTIVE)
  recursMonthly                Boolean                 @default(false) @map("recurs_monthly")
  recurrenceGroupId            String?                 @map("recurrence_group_id") @db.Uuid
  teacherMinCohortSize         Int                     @default(10) @map("teacher_min_cohort_size")
  teacherMinTenureDays         Int                     @default(14) @map("teacher_min_tenure_days")
  teacherReferenceStudentCount Int                     @default(20) @map("teacher_reference_student_count")
  teacherMaxLoadMultiplier     Decimal                 @default(1.25) @map("teacher_max_load_multiplier") @db.Decimal(4, 2)
  createdById                  String?                 @map("created_by_id") @db.Uuid
  createdAt                    DateTime                @default(now()) @map("created_at")
  updatedAt                    DateTime                @updatedAt @map("updated_at")

  createdBy     User?                       @relation("HrBonusCampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  stages        HrBonusStage[]
  participants  HrBonusParticipant[]
  adjustments   HrBonusProgressAdjustment[]
  teacherCohort HrBonusTeacherCohort[]

  @@unique([recurrenceGroupId, startsAt])
  @@index([department, startsAt, endsAt])
  @@index([status, startsAt, endsAt])
  @@index([createdById])
  @@map("hr_bonus_campaigns")
  @@schema("erp")
}

model HrBonusStage {
  id           String    @id @default(uuid()) @db.Uuid
  campaignId   String    @map("campaign_id") @db.Uuid
  sortOrder    Int       @map("sort_order")
  threshold    Decimal   @db.Decimal(14, 2)
  bonusPool    Decimal   @default(0) @map("bonus_pool") @db.Decimal(12, 2)
  bonusPercent Decimal   @default(0) @map("bonus_percent") @db.Decimal(5, 2)
  fixedAmount  Decimal   @default(0) @map("fixed_amount") @db.Decimal(12, 2)
  reachedAt    DateTime? @map("reached_at")
  reachedValue Decimal?  @map("reached_value") @db.Decimal(14, 2)
  createdAt    DateTime  @default(now()) @map("created_at")

  campaign   HrBonusCampaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  awards     HrBonusAward[]
  churnRules HrBonusTeacherChurnRule[]

  @@unique([campaignId, sortOrder])
  @@index([campaignId, threshold])
  @@map("hr_bonus_stages")
  @@schema("erp")
}

model HrBonusTeacherChurnRule {
  id              String   @id @default(uuid()) @db.Uuid
  stageId         String   @map("stage_id") @db.Uuid
  sortOrder       Int      @map("sort_order")
  churnThreshold  Int      @map("churn_threshold")
  deductionAmount Decimal  @map("deduction_amount") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  stage HrBonusStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, sortOrder])
  @@unique([stageId, churnThreshold])
  @@map("hr_bonus_teacher_churn_rules")
  @@schema("erp")
}

model HrBonusParticipant {
  id            String   @id @default(uuid()) @db.Uuid
  campaignId    String   @map("campaign_id") @db.Uuid
  employeeId    String?  @map("employee_id") @db.Uuid
  employeeName  String   @map("employee_name")
  employeeEmail String?  @map("employee_email")
  isEligible    Boolean  @default(true) @map("is_eligible")
  createdAt     DateTime @default(now()) @map("created_at")

  campaign      HrBonusCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  employee      HrEmployee?            @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  awards        HrBonusAward[]
  teacherCohort HrBonusTeacherCohort[]

  @@unique([campaignId, employeeId])
  @@index([employeeId])
  @@map("hr_bonus_participants")
  @@schema("erp")
}

model HrBonusTeacherCohort {
  id            String   @id @default(uuid()) @db.Uuid
  campaignId    String   @map("campaign_id") @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  teacherId     String   @map("teacher_id") @db.Uuid
  membershipId  String   @map("membership_id") @db.Uuid
  enrollmentId  String   @map("enrollment_id") @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  assignedAt    DateTime @map("assigned_at") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  campaign    HrBonusCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  participant HrBonusParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  teacher     Teacher            @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  membership  GroupMembership    @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  enrollment  Enrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  student     Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([campaignId, studentId])
  @@index([participantId])
  @@index([teacherId, campaignId])
  @@map("hr_bonus_teacher_cohorts")
  @@schema("erp")
}

model HrBonusProgressAdjustment {
  id          String   @id @default(uuid()) @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  amount      Decimal  @db.Decimal(14, 2)
  reason      String
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  campaign  HrBonusCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("HrBonusAdjustmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt])
  @@index([createdById])
  @@map("hr_bonus_progress_adjustments")
  @@schema("erp")
}

model HrBonusAward {
  id                 String             @id @default(uuid()) @db.Uuid
  stageId            String             @map("stage_id") @db.Uuid
  participantId      String             @map("participant_id") @db.Uuid
  amount             Decimal            @db.Decimal(12, 2)
  baseAmount         Decimal            @default(0) @map("base_amount") @db.Decimal(12, 2)
  percentAmount      Decimal            @default(0) @map("percent_amount") @db.Decimal(12, 2)
  fixedAmount        Decimal            @default(0) @map("fixed_amount") @db.Decimal(12, 2)
  workloadMultiplier Decimal            @default(1) @map("workload_multiplier") @db.Decimal(4, 2)
  metricValue        Decimal?           @map("metric_value") @db.Decimal(7, 2)
  calculationNote    String?            @map("calculation_note")
  status             HrBonusAwardStatus @default(PENDING_HR)
  approvedById       String?            @map("approved_by_id") @db.Uuid
  approvedAt         DateTime?          @map("approved_at")
  postedAt           DateTime?          @map("posted_at")
  voidReason         String?            @map("void_reason")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  stage          HrBonusStage       @relation(fields: [stageId], references: [id], onDelete: Cascade)
  participant    HrBonusParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  approvedBy     User?              @relation("HrBonusAwardApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  financeExpense FinanceExpense?

  @@unique([stageId, participantId])
  @@index([participantId, status])
  @@index([approvedById])
  @@map("hr_bonus_awards")
  @@schema("erp")
}

model MarketingCampaign {
  id          String                  @id @default(uuid()) @db.Uuid
  name        String
  channel     String
  owner       String?
  objective   String?
  notes       String?
  status      MarketingCampaignStatus @default(DRAFT)
  budget      Decimal                 @default(0) @db.Decimal(12, 2)
  startsAt    DateTime                @map("starts_at") @db.Date
  endsAt      DateTime?               @map("ends_at") @db.Date
  createdById String?                 @map("created_by_id") @db.Uuid
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  createdBy User?                     @relation("MarketingCampaignCreator", fields: [createdById], references: [id])
  stats     MarketingCampaignStat[]
  leads     Lead[]
  students  Student[]
  reports   MarketingCampaignReport[]

  @@index([status, startsAt])
  @@index([channel, startsAt])
  @@map("marketing_campaigns")
  @@schema("erp")
}

model MarketingCampaignReport {
  id          String                 @id @default(uuid()) @db.Uuid
  campaignId  String                 @map("campaign_id") @db.Uuid
  outcome     MarketingReportOutcome
  notes       String?
  createdById String?                @map("created_by_id") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at")

  campaign  MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy User?             @relation(fields: [createdById], references: [id])

  @@index([campaignId, createdAt])
  @@map("marketing_campaign_reports")
  @@schema("erp")
}

model MarketingCampaignStat {
  id          String   @id @default(uuid()) @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  recordedOn  DateTime @map("recorded_on") @db.Date
  spend       Decimal  @default(0) @db.Decimal(12, 2)
  revenue     Decimal  @default(0) @db.Decimal(12, 2)
  leads       Int      @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, recordedOn])
  @@index([recordedOn])
  @@map("marketing_campaign_stats")
  @@schema("erp")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        AppRole? @unique
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
  @@schema("erp")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
  @@schema("erp")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
  @@schema("erp")
}

model RolePermission {
  roleId       String          @map("role_id") @db.Uuid
  permissionId String          @map("permission_id") @db.Uuid
  scope        PermissionScope @default(ALL)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
  @@schema("erp")
}

model Contact {
  id              String   @id @default(uuid()) @db.Uuid
  fullName        String   @map("full_name")
  phoneDisplay    String?  @map("phone_display")
  phoneNormalized String?  @unique @map("phone_normalized")
  email           String?
  source          String?
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  leads                Lead[]
  students             Student[]
  teacherProfiles      Teacher[]
  studentRelationships StudentRelationship[]

  @@index([fullName])
  @@map("contacts")
  @@schema("erp")
}

model Lead {
  id                 String              @id @default(uuid()) @db.Uuid
  contactId          String              @map("contact_id") @db.Uuid
  stage              LeadStage           @default(NEW)
  source             String?
  sourceRef          String?             @unique @map("source_ref")
  managerId          String?             @map("manager_id") @db.Uuid
  programInterestId  String?             @map("program_interest_id") @db.Uuid
  nextFollowUpAt     DateTime?           @map("next_follow_up_at")
  nextActionType     LeadNextActionType? @map("next_action_type")
  priority           LeadPriority        @default(NORMAL)
  lostReason         String?             @map("lost_reason")
  convertedStudentId String?             @unique @map("converted_student_id") @db.Uuid
  campaignId         String?             @map("campaign_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  contact          Contact            @relation(fields: [contactId], references: [id])
  manager          User?              @relation("LeadManager", fields: [managerId], references: [id])
  programInterest  Program?           @relation(fields: [programInterestId], references: [id])
  convertedStudent Student?           @relation("LeadConvertedStudent", fields: [convertedStudentId], references: [id])
  campaign         MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  stageHistory     LeadStageHistory[]

  @@index([contactId])
  @@index([stage])
  @@index([managerId, stage])
  @@index([programInterestId])
  @@index([nextFollowUpAt])
  @@index([priority, nextFollowUpAt])
  @@index([campaignId, createdAt])
  @@map("leads")
  @@schema("erp")
}

model LeadStageHistory {
  id          String     @id @default(uuid()) @db.Uuid
  leadId      String     @map("lead_id") @db.Uuid
  oldStage    LeadStage? @map("old_stage")
  newStage    LeadStage  @map("new_stage")
  reason      String?
  changedById String?    @map("changed_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")

