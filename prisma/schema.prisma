  UNSUCCESSFUL

  @@schema("erp")
}

enum MarketingContentStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REVISION_REQUIRED

  @@schema("erp")
}

enum MarketingContentAction {
  CREATED
  UPDATED
  SUBMITTED
  APPROVED
  REVISION_REQUESTED

  @@schema("erp")
}

enum InstagramDmDirection {
