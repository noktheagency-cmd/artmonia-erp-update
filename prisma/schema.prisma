  updatedAt              DateTime          @updatedAt @map("updated_at")

  category        FinanceExpenseCategory @relation(fields: [categoryId], references: [id])
  employeeUser    User?                  @relation("FinanceExpenseEmployee", fields: [employeeUserId], references: [id])
  hrEmployee      HrEmployee?            @relation("FinanceExpenseHrEmployee", fields: [hrEmployeeId], references: [id], onDelete: SetNull)
  bonusAward      HrBonusAward?          @relation(fields: [bonusAwardId], references: [id], onDelete: Restrict)
  teacher         Teacher?               @relation("FinanceExpenseTeacher", fields: [teacherId], references: [id])
  createdBy       User?                  @relation("FinanceExpenseCreator", fields: [createdById], references: [id])
  workshopEvent   WorkshopEvent?         @relation(fields: [workshopEventId], references: [id], onDelete: Restrict)
  voidedBy        User?                  @relation("FinanceExpenseVoider", fields: [voidedById], references: [id])
  replacesExpense FinanceExpense?        @relation("FinanceExpenseReplacement", fields: [replacesExpenseId], references: [id], onDelete: Restrict)
  replacement     FinanceExpense?        @relation("FinanceExpenseReplacement")

  @@index([categoryId, expenseDate])
  @@index([employeeUserId])
  @@index([hrEmployeeId])
  @@index([teacherId])
  @@index([createdById])
  @@index([expenseDate])
  @@index([workshopEventId, expenseDate])
  @@index([voidedAt])
  @@index([voidedById])
  @@map("finance_expenses")
  @@schema("erp")
}

model RefundAdjustment {
  id                  String         @id @default(uuid()) @db.Uuid
  studentId           String         @map("student_id") @db.Uuid
  invoiceId           String?        @map("invoice_id") @db.Uuid
  paymentId           String?        @map("payment_id") @db.Uuid
  amount              Decimal        @db.Decimal(12, 2)
  reason              String
  status              ApprovalStatus @default(REQUESTED)
  requestedById       String?        @map("requested_by_id") @db.Uuid
  financeApprovedById String?        @map("finance_approved_by_id") @db.Uuid
  ownerApprovedById   String?        @map("owner_approved_by_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  student           Student  @relation(fields: [studentId], references: [id])
  invoice           Invoice? @relation(fields: [invoiceId], references: [id])
  payment           Payment? @relation(fields: [paymentId], references: [id])
  requestedBy       User?    @relation("RefundRequestedBy", fields: [requestedById], references: [id])
  financeApprovedBy User?    @relation("RefundFinanceApprovedBy", fields: [financeApprovedById], references: [id])
  ownerApprovedBy   User?    @relation("RefundOwnerApprovedBy", fields: [ownerApprovedById], references: [id])

  @@index([studentId, status])
  @@index([invoiceId])
  @@index([paymentId])
  @@index([requestedById])
  @@index([financeApprovedById])
  @@index([ownerApprovedById])
  @@map("refund_adjustments")
  @@schema("erp")
}

model TeacherContractRule {
  id                    String    @id @default(uuid()) @db.Uuid
  teacherId             String    @map("teacher_id") @db.Uuid
  salaryPercent         Decimal   @map("salary_percent") @db.Decimal(5, 2)
  teacherBroughtPercent Decimal?  @map("teacher_brought_percent") @db.Decimal(5, 2)
  validFrom             DateTime  @map("valid_from") @db.Date
  validTo               DateTime? @map("valid_to") @db.Date
  createdById           String?   @map("created_by_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")

  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("TeacherRuleCreator", fields: [createdById], references: [id])

  @@index([teacherId, validFrom])
  @@index([createdById])
  @@map("teacher_contract_rules")
  @@schema("erp")
}

model TeacherPayout {
  id               String         @id @default(uuid()) @db.Uuid
  teacherId        String         @map("teacher_id") @db.Uuid
  periodMonth      DateTime       @map("period_month") @db.Date
  eligibleRevenue  Decimal        @default(0) @map("eligible_revenue") @db.Decimal(12, 2)
  adjustmentAmount Decimal        @default(0) @map("adjustment_amount") @db.Decimal(12, 2)
  payoutAmount     Decimal        @default(0) @map("payout_amount") @db.Decimal(12, 2)
  status           ApprovalStatus @default(DRAFT)
  generatedById    String?        @map("generated_by_id") @db.Uuid
  approvedById     String?        @map("approved_by_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  teacher     Teacher             @relation(fields: [teacherId], references: [id])
  generatedBy User?               @relation("PayoutGeneratedBy", fields: [generatedById], references: [id])
  approvedBy  User?               @relation("PayoutApprovedBy", fields: [approvedById], references: [id])
  lines       TeacherPayoutLine[]

  @@unique([teacherId, periodMonth])
  @@index([generatedById])
  @@index([approvedById])
  @@map("teacher_payouts")
  @@schema("erp")
}

model TeacherPayoutLine {
  id              String   @id @default(uuid()) @db.Uuid
  payoutId        String   @map("payout_id") @db.Uuid
  enrollmentId    String?  @map("enrollment_id") @db.Uuid
  paymentId       String?  @map("payment_id") @db.Uuid
  eligibleRevenue Decimal  @map("eligible_revenue") @db.Decimal(12, 2)
  payoutAmount    Decimal  @map("payout_amount") @db.Decimal(12, 2)
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")

  payout     TeacherPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  enrollment Enrollment?   @relation(fields: [enrollmentId], references: [id])
  payment    Payment?      @relation(fields: [paymentId], references: [id])

  @@index([payoutId])
  @@index([enrollmentId])
  @@index([paymentId])
  @@map("teacher_payout_lines")
  @@schema("erp")
}

model Task {
  id             String     @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  type           String
  entityType     String?    @map("entity_type")
  entityId       String?    @map("entity_id") @db.Uuid
  ownerUserId    String?    @map("owner_user_id") @db.Uuid
  status         TaskStatus @default(OPEN)
  dueAt          DateTime?  @map("due_at")
  completedAt    DateTime?  @map("completed_at")
  idempotencyKey String?    @unique @map("idempotency_key")
  createdById    String?    @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  ownerUser User? @relation("TaskOwner", fields: [ownerUserId], references: [id])
  createdBy User? @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([ownerUserId, status, dueAt])
  @@index([createdById])
  @@index([entityType, entityId])
  @@map("tasks")
  @@schema("erp")
}

model Target {
  id           String   @id @default(uuid()) @db.Uuid
  periodMonth  DateTime @map("period_month") @db.Date
  targetAmount Decimal  @map("target_amount") @db.Decimal(12, 2)
  ownerUserId  String?  @map("owner_user_id") @db.Uuid
  programId    String?  @map("program_id") @db.Uuid
  managerId    String?  @map("manager_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  ownerUser User?    @relation("TargetOwner", fields: [ownerUserId], references: [id])
  program   Program? @relation(fields: [programId], references: [id])
  manager   User?    @relation("TargetManager", fields: [managerId], references: [id])

  @@index([ownerUserId])
  @@index([programId])
  @@index([managerId])
  @@index([periodMonth])
  @@map("targets")
  @@schema("erp")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  reason      String?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
  @@schema("erp")
}

model JobRun {
  id           String    @id @default(uuid()) @db.Uuid
  jobName      String    @map("job_name")
  status       String
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  affectedRows Int       @default(0) @map("affected_rows")
  errorMessage String?   @map("error_message")

  @@index([jobName, startedAt])
  @@map("job_runs")
  @@schema("erp")
}

model DataExport {
  id            String   @id @default(uuid()) @db.Uuid
  exportType    String   @map("export_type")
  filtersJson   Json?    @map("filters_json")
  rowCount      Int?     @map("row_count")
  filePath      String?  @map("file_path")
  requestedById String?  @map("requested_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  requestedBy User? @relation("ExportRequestedBy", fields: [requestedById], references: [id])

  @@index([requestedById])
  @@index([exportType, createdAt])
  @@map("exports")
  @@schema("erp")
}
