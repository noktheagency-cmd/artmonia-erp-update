  SUPER_ADMIN
  OWNER
  ADMIN
  SALES
  FINANCE
  TEACHER
  AUDITOR

  @@schema("erp")
}

enum KnowledgeSectionType {
  COMPANY
  PLAYBOOK

  @@schema("erp")
}

enum KnowledgeContentStatus {
  DRAFT
  PUBLISHED

  @@schema("erp")
}

enum PermissionScope {
