  createdAt       DateTime              @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceId], map: "payment_allocations_payment_invoice_unique")
  @@index([invoiceId])
  @@index([paymentId])
  @@map("payment_allocations")
  @@schema("erp")
}

model FinanceExpenseCategory {
  id              String                 @id @default(uuid()) @db.Uuid
  code            String                 @unique
  name            String                 @unique
  description     String?
  transactionType FinanceTransactionType @map("transaction_type")
  financialClass  FinanceFinancialClass? @map("financial_class")
  isActive        Boolean                @default(true) @map("is_active")
  isSystem        Boolean                @default(false) @map("is_system")
  requiresStaff   Boolean                @default(false) @map("requires_staff")
  requiresProject Boolean                @default(false) @map("requires_project")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  expenses FinanceExpense[]

  @@index([isActive, transactionType])
  @@index([financialClass, isActive])
  @@map("finance_expense_categories")
  @@schema("erp")
}

model FinanceExpense {
  id                           String                 @id @default(uuid()) @db.Uuid
  categoryId                   String                 @map("category_id") @db.Uuid
  amount                       Decimal                @db.Decimal(12, 2)
  expenseDate                  DateTime               @map("expense_date") @db.Date
  transactionType              FinanceTransactionType @default(EXPENSE) @map("transaction_type")
  financialClass               FinanceFinancialClass  @default(OPEX) @map("financial_class")
  costCenter                   FinanceCostCenter      @map("cost_center")
  method                       PaymentMethod          @default(CASH)
  vendor                       String?
  description                  String?
  employeeUserId               String?                @map("employee_user_id") @db.Uuid
  hrEmployeeId                 String?                @map("hr_employee_id") @db.Uuid
  bonusAwardId                 String?                @unique @map("bonus_award_id") @db.Uuid
  teacherId                    String?                @map("teacher_id") @db.Uuid
  salaryMode                   FinanceSalaryMode      @default(NONE) @map("salary_mode")
  salaryPercent                Decimal?               @map("salary_percent") @db.Decimal(5, 2)
  salaryBaseAmount             Decimal?               @map("salary_base_amount") @db.Decimal(12, 2)
  salaryCalculatedAmount       Decimal?               @map("salary_calculated_amount") @db.Decimal(12, 2)
  receiptFileName              String?                @map("receipt_file_name")
  receiptFilePath              String?                @map("receipt_file_path")
  receiptReference             String?                @map("receipt_reference")
  idempotencyKey               String?                @unique @map("idempotency_key") @db.Uuid
  workshopEventId              String?                @map("workshop_event_id") @db.Uuid
  corporateCustomerId          String?                @map("corporate_customer_id") @db.Uuid
  createdById                  String?                @map("created_by_id") @db.Uuid
  voidedAt                     DateTime?              @map("voided_at")
  voidedById                   String?                @map("voided_by_id") @db.Uuid
  voidReason                   String?                @map("void_reason")
  replacesExpenseId            String?                @unique @map("replaces_expense_id") @db.Uuid
  legacyCategoryName           String?                @map("legacy_category_name")
  classificationReviewRequired Boolean                @default(false) @map("classification_review_required")
  createdAt                    DateTime               @default(now()) @map("created_at")
  updatedAt                    DateTime               @updatedAt @map("updated_at")

  category          FinanceExpenseCategory @relation(fields: [categoryId], references: [id])
  employeeUser      User?                  @relation("FinanceExpenseEmployee", fields: [employeeUserId], references: [id])
  hrEmployee        HrEmployee?            @relation("FinanceExpenseHrEmployee", fields: [hrEmployeeId], references: [id], onDelete: SetNull)
  bonusAward        HrBonusAward?          @relation(fields: [bonusAwardId], references: [id], onDelete: Restrict)
  teacher           Teacher?               @relation("FinanceExpenseTeacher", fields: [teacherId], references: [id])
  createdBy         User?                  @relation("FinanceExpenseCreator", fields: [createdById], references: [id])
  workshopEvent     WorkshopEvent?         @relation(fields: [workshopEventId], references: [id], onDelete: Restrict)
  corporateCustomer HrCorporateCustomer?   @relation(fields: [corporateCustomerId], references: [id], onDelete: SetNull)
  voidedBy          User?                  @relation("FinanceExpenseVoider", fields: [voidedById], references: [id])
  replacesExpense   FinanceExpense?        @relation("FinanceExpenseReplacement", fields: [replacesExpenseId], references: [id], onDelete: Restrict)
  replacement       FinanceExpense?        @relation("FinanceExpenseReplacement")

  @@index([categoryId, expenseDate])
  @@index([financialClass, expenseDate])
  @@index([transactionType, expenseDate])
  @@index([corporateCustomerId, expenseDate])
  @@index([employeeUserId])
  @@index([hrEmployeeId])
  @@index([teacherId])
  @@index([createdById])
  @@index([expenseDate])
  @@index([workshopEventId, expenseDate])
  @@index([voidedAt])
  @@index([voidedById])
  @@map("finance_expenses")
  @@schema("erp")
}

model RefundAdjustment {
