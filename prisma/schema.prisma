model Task {
  id             String       @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  type           String
  entityType     String?      @map("entity_type")
  entityId       String?      @map("entity_id") @db.Uuid
  ownerUserId    String?      @map("owner_user_id") @db.Uuid
  status         TaskStatus   @default(OPEN)
  priority       TaskPriority @default(NORMAL)
  dueAt          DateTime?    @map("due_at")
  completedAt    DateTime?    @map("completed_at")
  completionNote String?      @map("completion_note")
  idempotencyKey String?      @unique @map("idempotency_key")
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  ownerUser     User?                  @relation("TaskOwner", fields: [ownerUserId], references: [id])
  createdBy     User?                  @relation("TaskCreator", fields: [createdById], references: [id])
  notifications PersonalNotification[]

  @@index([ownerUserId, status, dueAt])
  @@index([createdById])
  @@index([entityType, entityId])
  @@map("tasks")
  @@schema("erp")
}

model PersonalNotification {
  id                String                   @id @default(uuid()) @db.Uuid
  recipientUserId   String                   @map("recipient_user_id") @db.Uuid
  type              PersonalNotificationType
  title             String
  message           String
  href              String?
  relatedEntityType String?                  @map("related_entity_type")
  relatedEntityId   String?                  @map("related_entity_id") @db.Uuid
  taskId            String?                  @map("task_id") @db.Uuid
  metadata          Json?
  dedupeKey         String                   @unique @map("dedupe_key")
  readAt            DateTime?                @map("read_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  recipient User  @relation("PersonalNotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  task      Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([recipientUserId, readAt, createdAt(sort: Desc)])
  @@index([recipientUserId, type, readAt])
  @@index([taskId, createdAt])
  @@map("personal_notifications")
  @@schema("erp")
}

